# Токен бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# LLM: openai | claude | codex
LLM_PROVIDER=openai

# --- OpenAI ---
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=                    # оставить пустым для OpenAI

# --- DeepSeek (пример) ---
# LLM_PROVIDER=openai
# LLM_MODEL=deepseek-chat
# OPENAI_API_KEY=sk-...               # ключ DeepSeek (platform.deepseek.com)
# OPENAI_BASE_URL=https://api.deepseek.com

# --- Claude ---
# LLM_PROVIDER=claude
# LLM_MODEL=claude-3-haiku-20240307
# ANTHROPIC_API_KEY=sk-ant-...

# --- Codex CLI (по подписке ChatGPT) ---
# Установить: npm i -g @openai/codex, затем `codex login` от пользователя, под которым работает бот.
# LLM_PROVIDER=codex
# CODEX_BIN=codex                     # полный путь, если codex не в PATH systemd
# CODEX_MODEL=                        # пусто = модель по умолчанию из Codex
# CODEX_REASONING_EFFORT=low
# CODEX_TIMEOUT=120
# CODEX_SESSION_MAX_TURNS=150        # у каждого чата своя сессия Codex с историей; потом новая
# CODEX_SANDBOX=read-only           # read-only | workspace-write | danger-full-access
# CODEX_PLAYWRIGHT=1                 # браузер Playwright MCP для Codex там, где разрешён интернет

# ID каналов/групп через запятую. Оставьте пустым чтобы слушать ВСЕ группы с ботом.
CHANNEL_IDS=-1001234567890,-1009876543210

# Telegram ID владельцев через запятую. Только они дают команды /start /stop /status /debug
# и говорят с ботом в личке. Пусто = команды и личка закрыты для всех.
ADMIN_IDS=

# Telegram ID самого Максима. Его реплики боту (reply, упоминание, любое сообщение в личке) агент разбирает
# на поправки и предлагает их кнопками «Учесть / Нет»; нажать может только он.
PERSONA_IDS=

# Бот иногда пишет первым: Codex ищет в интернете находку по темам Максима и пишет о ней.
# Работает только с LLM_PROVIDER=codex.
PROACTIVE_ENABLED=0
# PROACTIVE_CHAT_IDS=                # пусто = все группы, где бот видел сообщения
# PROACTIVE_MIN_HOURS=12             # интервал между постами — случайный, от MIN до MAX часов
# PROACTIVE_MAX_HOURS=48
# PROACTIVE_HOURS=10-22              # только в эти часы
# PROACTIVE_TZ=Europe/Paris
# PROACTIVE_TOPICS={"-1001591588448": "баня, концерты, книги, быт"}  # темы постов по чатам; нет чата — по истории

# Где хранить поправки Максима. В Docker задан том, менять не нужно.
# DATA_DIR=data

# Бот активен сразу после запуска/restart. Установите 0, если нужен ручной /start.
BOT_AUTO_START=1

# Потолок прямых ответов в одной группе за 10 минут. Модель и так может промолчать (SKIP).
# DIRECT_MAX_PER_10MIN=6

# Reply на сообщение бота — прямое обращение: без кулдауна, модель решает сама, отвечать ли (1=да, 0=нет).
REPLY_FORCE_RESPOND=1

# Отвечать всегда, когда в тексте упоминают бота по @username или по имени «Дементий» (1=да, 0=нет).
# Reply, @username и «Дементий» идут в обход кулдауна и дневного лимита.
MENTION_FORCE_RESPOND=1

# Вероятность предложить LLM одну контекстную фразу Максима (0..1).
# Фраза не дописывается механически: модель может её проигнорировать.
STYLE_CUE_PROBABILITY=0.20

# Вероятность показать LLM 2–3 крылатые фразы из советских фильмов.
# Модель может взять максимум одну, если она уместна.
FILM_CUE_PROBABILITY=0.12

# Сколько фраз из фильмов показывать за раз (2 или 3)
FILM_CUE_COUNT=3

# Оверрайды триггера по людям: сдвиг score их сообщений (порог ответа 25)
# USER_TRIGGER_BOOST=977070655:10
